# Token do seu Bot no Discord Developer Portal
DISCORD_TOKEN=seu_token_aqui

# Prefixo opcional para comandos de mensagem (ex: !, ?, .)
# Comandos terminados com o sufixo "a" (ex: "3d6 a", "d12 a") funcionam com ou sem prefixo por padrão.
COMMAND_PREFIX=!

# Se "true", aceita chamadas sem prefixo quando terminam com sufixo "a" (ex: "3d6 a", "d12 a", "2d6+1d10 a")
ALLOW_BARE_SUFFIX_A=true

# Se "true", sincroniza automaticamente os ícones oficiais como Emojis da Aplicação no Discord ao iniciar
SYNC_APP_EMOJIS=true
